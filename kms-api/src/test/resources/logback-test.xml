<configuration>
    <conversionRule conversionWord="redactedMsg"
                    converterClass="io.github.realnribal.hsmkms.logging.RedactingConverter"/>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/tnr/kms-test.log</file>
        <append>false</append>
        <immediateFlush>true</immediateFlush>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level logger=%logger{36} trace=%X{traceId:-} op=%X{op:-} alias=%X{alias:-} %redactedMsg%n%ex{12}</pattern>
        </encoder>
    </appender>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} level=%-5level trace=%X{traceId:-} op=%X{op:-} alias=%X{alias:-} %redactedMsg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
